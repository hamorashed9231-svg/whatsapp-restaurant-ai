// هذا هو ملف إعداد Prisma ORM لقاعدة البيانات الخاصة بك.
// يحدد نوع الاتصال بقاعدة البيانات ومخطط الجداول (Schema).

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// نموذج المطعم (Restaurant)
model Restaurant {
  id                      String        @id @default(uuid())
  name                    String
  phone_number            String        // رقم هاتف المطعم العام
  whatsapp_number_id      String        @unique // معرف رقم الهاتف المخصص لبيزنس واتساب لتحديد المطعم
  whatsapp_access_token   String?       // رمز الوصول (Token) المخصص للواتساب الخاص بالمطعم
  catalog_id              String?       // معرف كتالوج المنتجات المخصص على Meta Commerce Catalog
  subscription_tier       String        // فئة الاشتراك (مثال: FREE, PREMIUM)
  subscription_status     String        // حالة الاشتراك (مثال: ACTIVE, EXPIRED, TRIAL)
  subscription_expires_at DateTime
  ai_instructions         String?       // تعليمات وقواعد الذكاء الاصطناعي الإضافية من الإدارة
  custom_categories      Json?         // التصنيفات المخصصة للمنيو كـ JSON Array
  quick_replies          Json?         // الردود السريعة المخصصة كـ JSON Array
  created_at              DateTime      @default(now())

  // العلاقات (Relations)
  menu_items              MenuItem[]
  conversations           Conversation[]
  orders                  Order[]
  reservations            Reservation[]
  users                   User[]
  branches                Branch[]
  customers               Customer[]

  @@map("restaurants") // رسم خريطة لاسم الجدول ليكون بصيغة الجمع
}

// نموذج عناصر المنيو (MenuItem)
model MenuItem {
  id            String     @id @default(uuid())
  restaurant_id String
  name          String
  description   String?
  price         Decimal    @db.Decimal(10, 2)
  category      String     // التصنيف (مثال: وجبات رئيسية، مقبلات، مشروبات)
  image_url             String?    // رابط صورة الصنف
  is_available          Boolean    @default(true)
  last_meta_sync_status String?    // حالة آخر مزامنة مع كتالوج Meta: SUCCESS أو FAILED
  last_meta_sync_at     DateTime?  // تاريخ وقت آخر مزامنة مع Meta
  last_meta_sync_error  String?    // تفاصيل الخطأ في حال فشل المزامنة

  // العلاقات
  restaurant    Restaurant            @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  branch_prices BranchMenuItemPrice[]

  @@map("menu_items")
}

// نموذج الفروع (Branch)
model Branch {
  id                 String   @id @default(uuid())
  restaurant_id      String
  name               String   // اسم الفرع (مثال: فرع المعادي)
  address            String?  // عنوان الفرع التقريبي/التفصيلي
  phone_number       String?  // رقم هاتف الفرع (اختياري)
  catalog_id         String?  // معرف كتالوج Meta Commerce Manager المخصص لهذا الفرع
  whatsapp_number_id String?  // معرف رقم الواتساب المخصص للفرع (اختياري)
  is_default         Boolean  @default(false) // هل هذا هو الفرع الافتراضي للمطعم؟
  is_active          Boolean  @default(true)
  created_at         DateTime @default(now())

  // العلاقات
  restaurant    Restaurant            @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  branch_prices BranchMenuItemPrice[]

  @@map("branches")
}

// نموذج أسعار الأصناف المخصصة لكل فرع (BranchMenuItemPrice)
model BranchMenuItemPrice {
  id           String   @id @default(uuid())
  branch_id    String
  menu_item_id String
  price        Decimal  @db.Decimal(10, 2) // السعر الخاص بهذا الفرع
  is_available Boolean  @default(true)     // توافر الصنف في هذا الفرع بالذات

  // العلاقات
  branch    Branch   @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  menu_item MenuItem @relation(fields: [menu_item_id], references: [id], onDelete: Cascade)

  @@unique([branch_id, menu_item_id]) // يمنع تكرار السعر لنفس الصنف في نفس الفرع
  @@map("branch_menu_item_prices")
}

// نموذج سجل المحادثات (Conversation)
model Conversation {
  id             String     @id @default(uuid())
  restaurant_id  String
  customer_phone String     // رقم هاتف الزبون
  customer_name  String?    // اسم الزبون المجلوب من واتساب
  messages_json  Json       // سجل الرسائل بصيغة JSON (مصفوفة متوافقة)
  status         String     // حالة المحادثة: UNANSWERED (لم يتم الرد), IN_PROGRESS (جاري المتابعة), CLOSED (مغلقة)
  category       String     @default("INQUIRY") // تصنيف المحادثة (INQUIRY, ORDER, COMPLAINT)
  assigned_to    String?    // اسم الموظف المتابع للمحادثة (المسند إليه)
  closed_by      String?    // اسم الموظف الذي قام بإغلاق المحادثة
  is_archived    Boolean    @default(false) // هل المحادثة مؤرشفة
  is_blocked     Boolean    @default(false) // هل المحادثة والعميل محظوران
  blocked_at     DateTime?  // تاريخ ووقت الحظر
  created_at     DateTime   @default(now())
  updated_at     DateTime   @updatedAt

  // العلاقات
  restaurant     Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  messages       Message[]

  @@map("conversations")
}

// نموذج الرسائل الفردية (Message) لتفادي تضارب التحديثات المتزامنة
model Message {
  id              String       @id @default(uuid())
  conversation_id String
  role            String       // "user" | "assistant" | "system"
  content         String       @db.Text
  media_id        String?
  image_url       String?
  audio_url       String?
  document_url    String?
  created_at      DateTime     @default(now())

  // العلاقات
  conversation    Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@map("messages")
}

// نموذج الطلبات (Order)
model Order {
  id             String     @id @default(uuid())
  restaurant_id  String
  customer_phone String
  items_json     Json       // تفاصيل العناصر المطلوبة والكميات والأسعار كـ JSON
  total_price    Decimal    @db.Decimal(10, 2)
  status         String     // حالة الطلب (مثال: PENDING, PREPARING, DELIVERED, CANCELLED)
  created_at     DateTime   @default(now())

  // العلاقات
  restaurant     Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@map("orders")
}

// نموذج الحجوزات (Reservation)
model Reservation {
  id             String     @id @default(uuid())
  restaurant_id  String
  customer_phone String
  date_time      DateTime   // تاريخ ووقت الحجز
  party_size     Int        // عدد الأفراد
  status         String     // حالة الحجز (مثال: PENDING, CONFIRMED, COMPLETED, CANCELLED)

  // العلاقات
  restaurant     Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@map("reservations")
}

// نموذج المستخدمين لإدارة الموظفين والمسؤولين
model User {
  id            String      @id @default(uuid())
  username      String      @unique
  password      String      // كلمة المرور مشفرة بـ SHA-256
  role          String      // الدور: "admin" (مسؤول) أو "staff" (موظف)
  restaurant_id String?
  restaurant    Restaurant? @relation(fields: [restaurant_id], references: [id], onDelete: SetNull)
  created_at    DateTime    @default(now())

  @@map("users")
}

// نموذج التخزين الدائم للوسائط (Vercel Blob Storage Cache)
model MediaAsset {
  id            String   @id @default(uuid())
  media_id      String   @unique
  permanent_url String
  mime_type     String?
  created_at    DateTime @default(now())

  @@index([media_id])
  @@map("media_assets")
}

// نموذج السجل الدائم للعميل (Customer Loyalty Profile)
model Customer {
  id                        String                   @id @default(uuid())
  restaurant_id             String
  customer_phone            String
  customer_name             String?
  total_conversations_count Int                      @default(1)
  first_seen_at             DateTime                 @default(now())
  last_seen_at              DateTime                 @default(now())
  created_at                DateTime                 @default(now())
  updated_at                DateTime                 @updatedAt

  // العلاقات
  restaurant                Restaurant               @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  conversation_logs         CustomerConversationLog[]

  // المفتاح المركب للعزل التام بين المطاعم والأدلة
  @@unique([restaurant_id, customer_phone])
  @@index([restaurant_id])
  @@index([customer_phone])
  @@index([created_at])
  @@map("customers")
}

// نموذج سجل تواريخ المحادثات القديمة (Conversation Timeline Log)
model CustomerConversationLog {
  id              String   @id @default(uuid())
  customer_id     String
  conversation_id String   // معرف المحادثة الأصلي (للتتبع فقط)
  started_at      DateTime
  closed_at       DateTime
  is_purged       Boolean  @default(false) // هل تم تطهير الرسائل والوسائط
  created_at      DateTime @default(now())

  // العلاقات
  customer        Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([customer_id])
  @@index([started_at])
  @@map("customer_conversation_logs")
}

