# منفذ تشغيل الخادم
PORT=3000

# رابط الاتصال بقاعدة بيانات PostgreSQL (مطلوب لـ Prisma)
# مثال: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DB_URL="postgresql://postgres:postgres@localhost:5432/whatsapp_restaurant_db?schema=public"

# رمز الوصول الخاص بـ WhatsApp API (WhatsApp Cloud API Token)
WHATSAPP_TOKEN="EAAG..."

# معرف رقم الهاتف المخصص لـ WhatsApp Business API (WhatsApp Phone Number ID)
WHATSAPP_PHONE_NUMBER_ID="1234567890"

# رمز التحقق للـ Webhook (Webhook Verify Token) المختار من قبلك لربطه في فيسبوك مطورين
WEBHOOK_VERIFY_TOKEN="my_secure_verify_token_123"

# مفتاح الوصول الخاص بـ Anthropic Claude API (API Key)
ANTHROPIC_API_KEY="sk-ant-api03..."

# مفاتيح الأمان للمصادقة وتأمين لوحة التحكم (JWT Auth)
JWT_SECRET="super_secret_jwt_key_change_me_in_production"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin_password_123"
